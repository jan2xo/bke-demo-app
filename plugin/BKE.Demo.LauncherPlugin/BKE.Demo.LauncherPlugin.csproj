<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>BKE.Demo.LauncherPlugin</AssemblyName>
    <RootNamespace>BKE.Demo.LauncherPlugin</RootNamespace>
    <BkeLauncherRoot Condition="'$(BkeLauncherRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\..\'))</BkeLauncherRoot>
    <BkeLauncherAbstractionsProject>$(BkeLauncherRoot)\src\BKE.Launcher.Plugin.Abstractions\BKE.Launcher.Plugin.Abstractions.csproj</BkeLauncherAbstractionsProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(BkeLauncherAbstractionsProject)" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
  </ItemGroup>

  <Target Name="RequireBkeLauncherAbstractions" BeforeTargets="ResolveProjectReferences"
          Condition="!Exists('$(BkeLauncherAbstractionsProject)')">
    <Error Text="BKE Launcher plugin abstractions are unavailable. Build inside a pinned Launcher checkout or pass -p:BkeLauncherRoot=&lt;path&gt;." />
  </Target>
</Project>
